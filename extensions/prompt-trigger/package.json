{
  "name": "pi-prompt-trigger",
  "description": "File-triggered prompts for the Pi coding agent: files dropped into a watched directory are injected into the running TUI as if typed by the user",
  "version": "0.2.0",
  "keywords": [
    "pi-package",
    "pi",
    "automation",
    "prompt"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/didier-durand/pi-fleet-kit.git",
    "directory": "extensions/prompt-trigger"
  },
  "files": [
    "prompt-trigger.ts",
    "src/",
    "send.sh",
    "README.md",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./prompt-trigger.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "test": "node --test --experimental-test-module-mocks"
  },
  "type": "module"
}
