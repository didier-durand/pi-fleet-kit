# Pi agent sandbox image.
# Build from this directory:
#   docker build -t pi-sandbox -f Dockerfile.pi .
FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends bash ca-certificates curl git ripgrep openssh-client \
  && rm -rf /var/lib/apt/lists/*

# GitHub CLI (gh): not in Debian bookworm's main repository — install from
# the official cli.github.com apt repository instead (arch-agnostic: the
# right binary is picked whether the image is built on amd64 or arm64).
# gh authenticates directly from the environment (GITHUB_TOKEN/GH_TOKEN),
# which compose passes through — no `gh auth login` needed in containers.
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    > /etc/apt/sources.list.d/github-cli.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends gh \
  && rm -rf /var/lib/apt/lists/*
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent

# Entrypoint wrapper: sets git identity + token-based credential helper from
# env vars passed by docker compose, then execs `pi`.
COPY utils/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Run as an unprivileged user (least privilege): the agent executes arbitrary
# shell commands, so it must not be able to tamper with system files, its own
# runtime, or anything outside its workspace/home. Note: runtime package
# installs (apt/npm global) are therefore impossible by design — everything
# the agent needs must be baked into the image.
# (USER pi must come after all root-only setup above.)
RUN useradd -m -s /bin/bash pi \
  && mkdir -p /workspace \
  && chown pi:pi /workspace
USER pi
ENV HOME=/home/pi

# The compose file mounts named volumes here (per-agent Pi home). The path
# must pre-exist and be pi-owned, otherwise Docker initializes a fresh empty
# volume as root and the unprivileged agent gets EACCES on first use:
RUN mkdir -p /home/pi/.pi/agent

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
