# docker compose .env for ~/pi-fleet-kit/compose.yml
# Resolved from the HOST environment when compose parses this file
# (host env takes precedence over values defined here).

# Pass through the existing host environment variable:
OPENROUTER_API_KEY=${OPENROUTER_API_KEY}

# GitHub auth for agents (same passthrough pattern as above):
GITHUB_TOKEN=${GITHUB_TOKEN}

# Git commit identity for the agents (entrypoint sets git config from these).
# Export them in the host shell, or hardcode the values here instead:
GITHUB_USER_NAME=${GITHUB_USER_NAME}
GITHUB_USER_EMAIL=${GITHUB_USER_EMAIL}
