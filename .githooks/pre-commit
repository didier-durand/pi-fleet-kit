#!/usr/bin/env bash
# Pre-commit guard: refuse commits containing literal secret values, in ANY
# tracked file.
#
# Three layers:
#   1. Repo policy: .env must hold only ${VAR} references (no literal
#      values) — checked whenever .env is staged.
#   2. Hygiene: any staged .DS_Store is unstaged, and all .DS_Store
#      files are deleted from the working tree (macOS Finder noise).
#   3. Generic scan: all staged files are scanned for well-known secret
#      token formats (ghp_, github_pat_, sk-*, AKIA..., glpat-..., PEM
#      keys, generic high-entropy assignments to *TOKEN*/*KEY*/... vars).
#
# To bypass in a genuine emergency (you shouldn't): git commit --no-verify
set -euo pipefail

fail=0

# --- Layer 1: .env must contain references, not literals -------------------
if ! git diff --cached --quiet -- .env; then
  violations=$(git show :.env 2>/dev/null | grep -nE \
    '^[A-Za-z_]*(TOKEN|KEY|SECRET|PASSWORD|PASSWD)[A-Za-z_]*=' \
    | grep -vE '=(\$\{[^}]*\}|""|'"'"''"'"')?\s*(#.*)?$' || true)
  if [[ -n "$violations" ]]; then
    echo "ERROR: .env contains literal secret values — refusing to commit." >&2
    echo "$violations" | sed 's/^/  .env:/' >&2
    echo "Fix: use \${VAR} references (resolved from the host env)." >&2
    fail=1
  fi
fi

# --- Layer 2: remove all .DS_Store files -----------------------------------
# Unstage any staged .DS_Store and delete every .DS_Store in the working
# tree (macOS Finder noise; already gitignored, but clean up strays).
ds_staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.DS_Store' '.DS_Store' || true)
if [[ -n "$ds_staged" ]]; then
  git reset -q -- '*.DS_Store' '.DS_Store'
  echo "Removed staged .DS_Store file(s):" >&2
  echo "$ds_staged" | sed 's/^/  /' >&2
  fail=1   # let the user re-stage intentionally rather than committing half-prepared state
fi
# Sweep the working tree, including nested directories:
ds_found=$(find . -name .DS_Store -type f -not -path './.git/*' -print -delete)
if [[ -n "$ds_found" ]]; then
  echo "Deleted .DS_Store file(s) from the working tree:" >&2
  echo "$ds_found" | sed 's/^/  /' >&2
fi

# --- Layer 3: scan ALL staged files for known secret formats ---------------
# Known token signatures (checked against staged file content):
patterns='ghp_[A-Za-z0-9]{20,}|gho_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-or-v1-[A-Za-z0-9]{20,}|sk-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|glpat-[A-Za-z0-9_-]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----'

staged=$(git diff --cached --name-only --diff-filter=ACM)
[[ -z "$staged" ]] && { (( fail )) && exit 1 || exit 0; }

while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  # Skip this hook itself: its source contains the detection patterns.
  [[ "$f" == .githooks/* ]] && continue
  # Binary files: check, but report only file name (grep would print noise):
  if hits=$(git show ":$f" 2>/dev/null | grep -nE "$patterns" | head -5); then
    if [[ -n "$hits" ]]; then
      echo "ERROR: possible secret in staged file '$f' — refusing to commit." >&2
      # Show line numbers only, never the matching content, so the guard
      # itself never echoes a secret into logs/terminals:
      echo "$hits" | cut -d: -f1 | sed 's/^/  line /; s/$/ looks like a credential/' >&2
      echo "Remove the secret, or if this is a false positive, restructure" >&2
      echo "the code so the pattern does not appear verbatim." >&2
      fail=1
    fi
  fi
done <<< "$staged"

# Bypass hatch (documented, for maintainers only):
if (( fail )); then
  echo "Commit blocked. (Emergency override: git commit --no-verify)" >&2
  exit 1
fi
exit 0

# --- Layer 4: fleet registry freshness -------------------------------------
# If compose.yml is staged, the fleet registry (fleet/agent-registry.md) must
# be regenerated from the STAGED compose.yml and staged too. Prevents the
# registry from silently drifting from the actual fleet config.
if git diff --cached --name-only --diff-filter=ACM | grep -q '^compose\.yml$'; then
  REPO_DIR="$(git rev-parse --show-toplevel)"
  staged_compose="$(mktemp)"
  staged_registry="$(mktemp)"
  regen="$(mktemp)"
  git show :compose.yml > "$staged_compose"
  "$REPO_DIR/utils/gen-fleet-registry.sh" "$staged_compose" - > "$regen" 2>/dev/null \
    || { echo "ERROR: could not regenerate the fleet registry." >&2; fail=1; }
  if git diff --cached --quiet -- fleet/agent-registry.md; then
    # registry not staged in this commit: compare against HEAD version
    git show HEAD:fleet/agent-registry.md > "$staged_registry" 2>/dev/null || : > "$staged_registry"
  else
    git show :fleet/agent-registry.md > "$staged_registry"
  fi
  if ! cmp -s "$regen" "$staged_registry"; then
    echo "ERROR: fleet/agent-registry.md is out of date with the staged compose.yml." >&2
    echo "Run:  utils/gen-fleet-registry.sh && git add fleet/agent-registry.md" >&2
    fail=1
  fi
  rm -f "$staged_compose" "$staged_registry" "$regen"
fi
